# Necookie AI — Environment Variables Reference
# Put PUBLIC_CLERK_PUBLISHABLE_KEY in .env for the client build.
# Put server secrets in .dev.vars for local development and in Worker secrets for production.
# Both local files are git-ignored and should NEVER be committed.

# The base URL of the Necookie AI chat API (Ollama-compatible endpoint)
NECOOKIE_ENDPOINT=https://model.necookie.dev/api/chat

# The model name served by the Ollama instance
NECOOKIE_MODEL=qwen2.5-coder:3b

# Cloudflare Access service token — Client ID
# Format: <token>.access
MODEL_ACCESS_CLIENT_ID=your_cloudflare_client_id.access

# Cloudflare Access service token — Client Secret
MODEL_ACCESS_CLIENT_SECRET=your_cloudflare_client_secret

# The connection URL of your Turso SQLite database
TURSO_DATABASE_URL=libsql://your-database.turso.io

# The access token generated from your Turso dashboard
TURSO_AUTH_TOKEN=your_turso_auth_token

# Clerk Authentication Configuration
PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
