# Necookie AI — Environment Variables Reference
# Copy this file to .env and fill in your values.
# .env is git-ignored and should NEVER be committed.

# The base URL of the Necookie AI chat API (Ollama-compatible endpoint)
NECOOKIE_ENDPOINT=https://ai.necookie.dev/api/chat

# The model name served by the Ollama instance
NECOOKIE_MODEL=necookie-ai

# Cloudflare Access service token — Client ID
# Format: <token>.access
NECOOKIE_CLIENT_ID=your_cloudflare_client_id.access

# Cloudflare Access service token — Client Secret
NECOOKIE_CLIENT_SECRET=your_cloudflare_client_secret
